# Copy to .env.local and fill in. Never commit .env.local.
# Setup steps for each of these are in ../stack.md.

# --- Supabase (supabase.com, project region eu-west-1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform ---
# Enable Geocoding API + Distance Matrix API. Restrict the key to those two.
# Set a billing alert at EUR 5.
GOOGLE_MAPS_API_KEY=

# Maynooth University, North Campus. Origin for every walk/cycle time.
NEXT_PUBLIC_CAMPUS_LAT=53.3814
NEXT_PUBLIC_CAMPUS_LNG=-6.6017

# --- Twilio Verify (host phone verification) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Resend (transactional email: weekly confirmations, outcome checks) ---
RESEND_API_KEY=
EMAIL_FROM="Digs <hello@example.ie>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where report emails land. An email address is a sufficient report route at MVP.
REPORTS_EMAIL=
