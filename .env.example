
# --- Scheduled jobs ---
# Shared secret for /api/cron/freshness. Vercel Cron sends it as a bearer
# token; the route refuses every request without it. Any long random string.
CRON_SECRET=

# --- Admin ---
# Comma separated. Anyone signed in with one of these addresses sees /admin.
# Empty means nobody, which is the safe default: never leave it unset expecting
# it to fall back to something.
ADMIN_EMAILS=
